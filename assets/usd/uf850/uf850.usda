#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1.0
    doc = "UFactory 850 FK hierarchy. Rotate each joint's rotateXYZ to drive FK."
)

def Xform "uf850"
{
    def Xform "base"
    {
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:rotateXYZ = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

        def Mesh "mesh" (
            payload = @./base.usd@</mesh>
        )
        {
        }

        def Xform "joint_1"
        {
            double3 xformOp:translate = (0, 0, 0)
            double3 xformOp:rotateXYZ = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

            def Mesh "mesh" (
                payload = @./joint_1.usd@</mesh>
            )
            {
            }

            def Xform "joint_2"
            {
                double3 xformOp:translate = (0, 0.364, 0)
                double3 xformOp:rotateXYZ = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

                def Mesh "mesh" (
                    payload = @./joint_2.usd@</mesh>
                )
                {
                }

                def Xform "joint_3"
                {
                    double3 xformOp:translate = (0, 0.39, 0)
                    double3 xformOp:rotateXYZ:pre = (180, 0, 0)
                    double3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:rotateXYZ:post = (-180, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ:pre", "xformOp:rotateXYZ", "xformOp:rotateXYZ:post"]

                    def Mesh "mesh" (
                        payload = @./joint_3.usd@</mesh>
                    )
                    {
                    }

                    def Xform "joint_4"
                    {
                        double3 xformOp:translate = (0.15, 0, 0)
                        double3 xformOp:rotateXYZ = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

                        def Mesh "mesh" (
                            payload = @./joint_4.usd@</mesh>
                        )
                        {
                        }

                        def Xform "joint_5"
                        {
                            double3 xformOp:translate = (0, -0.426, 0)
                            double3 xformOp:rotateXYZ = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

                            def Mesh "mesh" (
                                payload = @./joint_5.usd@</mesh>
                            )
                            {
                            }

                            def Xform "joint_6"
                            {
                                double3 xformOp:translate = (0, -0.06, 0)
                                double3 xformOp:rotateXYZ = (0, 0, 0)
                                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

                                def Mesh "mesh" (
                                    payload = @./joint_6.usd@</mesh>
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
